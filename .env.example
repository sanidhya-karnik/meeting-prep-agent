# PreCall Briefing Environment Variables

# LLM Configuration (Podman AI Lab)
LLM_URL=http://host.containers.internal:8080

# PostgreSQL (CRM Database)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crm
DB_USER=crm_user
DB_PASS=crm_pass

# Agent URLs (internal container network)
CRM_AGENT_URL=http://crm-agent:8001
COMMS_AGENT_URL=http://comms-agent:8002
DOCS_AGENT_URL=http://docs-agent:8003
ANALYTICS_AGENT_URL=http://analytics-agent:8004

# Orchestrator URL (for UI)
ORCHESTRATOR_URL=http://orchestrator:8000
